" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">In considering which medium to use for your message, it is important to consider: 1. Media richness–the medium&amp;#x27;s ability to utilize more than one informational cue, facilitate feedback, and establish personal focus; 2. Message formality, including your audience&amp;#x27;s expectations for style and tone; 3. Media limitations; 4. Sender intentions–your choice of medium will influence how the audience perceives your intentions; 5. Urgency and cost; and 6. Audience preferences, paying close attention to any cultural variations.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797977_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">Your organization decides to switch its top-down decision-making structure with a participatory approach, in which all employees have a say in decision-making. Draft the message using first the direct and then the indirect approach. Describe the type of audience for each approach and explain why that particular approach is necessary.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">The direct approach can be used when you know your audience will be receptive to your message. This starts with the main idea (such as a recommendation, conclusion, or request) and follows that with supporting evidence. Employees who had previously no say in decision-making will be receptive to the new approach and may be reached through the direct approach.&lt;br&gt;The indirect approach can be used when the audience will be skeptical about or even resistant to the message. It generally starts with the evidence first and build a case before presenting the main idea. Note that taking the indirect approach does not mean avoiding tough issues or talking around in circles. It simply means building up to the main idea in a careful and logical way. The indirect approach may be used to address the higher levels of the organization, who, under the previous structure, made most of the decisions.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797978_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">School authorities are about to introduce tough new security measures to prevent crime on campus. Students will have to carry identification at all times, and some activities will be restricted. Draft a message explaining the new rules using either the direct or indirect approach. Explain which approach the school should use to communicate with students and why.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">Students may perceive the new security measures negatively, viewing them as restrictions on their freedom. The best approach to communicate the new measures in this case is the indirect approach. This approach is used when the audience is skeptical about or even resistant to the message. With the indirect approach, the message starts with the evidence first, and a case is built before presenting the main idea.&lt;br&gt;Indirect approach: &amp;quot;Crime on campus has escalated drastically over the past two months. Crimes against students have tripled compared to last year and show no signs of abating. To ensure the safety of students and faculty, the school is instituting new rules and heightened security measures. Effective February 1, 2011, students are required to carry identification at all times and comply with the instructions of the security guards on campus. All meetings of groups and associations will conclude by 9:00 p.m. Please cooperate with the security team to ensure your safety.&amp;quot;&lt;br&gt;Students may react positively to the message as it makes the campus safer. If this is the likely reaction, the university authorities can use the direct approach, which starts with the main idea (such as a recommendation, conclusion, or request) and follows it with supporting evidence.&lt;br&gt;Direct approach: &amp;quot;Effective February 1, 2011, all students will be required to carry school identification at all times. All meetings of groups and associations on campus will conclude by 9:00 p.m., and students are requested to comply with the instructions of campus security. These measures have been taken in view of the increasing number of crimes on campus. Please cooperate with the security team to ensure your safety.&amp;quot;</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797979_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">Using an example, explain the advantages of the storytelling method in business communications.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">Stories can be an effective way to organize messages in a surprising number of business communication scenarios, from recruiting and training employees to enticing investors and customers. Career-related stories, such as how someone sought and found the opportunity to work on projects he or she is passionate about, can entice skilled employees to consider joining a firm. Entrepreneurs use stories to help investors see how their new ideas have the potential to affect people lives (and therefore generate lots of sales). Stories can be cautionary tales as well, dramatizing the consequences of career blunders, ethical mistakes, and strategic missteps.&lt;br&gt;A key reason storytelling can be so effective is that stories help readers and listeners imagine themselves living through the experience of the person in the story. As a result, people tend to remember and respond to the message in ways that can be difficult to achieve with other forms of communication. In addition, stories can demonstrate cause-and-effect relationships in a compelling fashion.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797980_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">Discuss the benefits of using storytelling techniques in business communications.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">Storytelling is an extremely common device and is very familiar to us both as communicators and as audiences. Storytelling is relatively natural to do and it is easy to adapt the classic three-part story narrative to most business situations. One of the reasons that storytelling is so effective is that listeners can imagine themselves living through the experience of the person in the story, thus increasing retention.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797981_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">Discuss what haptic technologies are and how they are important in business.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">&lt;i&gt;Haptic communication&lt;/i&gt;, or &lt;i&gt;haptics&lt;/i&gt;, is the study of touch in a communication context. Touch is a vital aspect of human-to-human and human-to-machine interaction, but it is missing from most forms of digital communication. You can&amp;#x27;t give someone a hearty handshake over email or feel the vibration patterns of a machine while viewing it over a video link. The technology has exciting potential in such diverse areas as training, online retailing, and increasing the number of devices that are usable by people with limited vision.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797982_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">In the planning stage of writing, what could you use an artificial intelligence (AI) assistant such as ChatGPT? List three things.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797983_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">Why do you need to cite information generated when using an artificial intelligence (AI) assistant such as ChatGPT? Provide an example of how you can do this.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">You must acknowledge its use because using AI responsibly and ethically is an important skill, not just in college, but also in the workplace. Text generated using ChatGPT should include a citation; Answers will vary for the example but here is an accepted format: &amp;quot;ChatGPT-4. (YYYY, Month, Date of query). Text of your query. Generated using OpenAI. https:// chat.openai.com.&amp;quot;</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item><item maxattempts="0"><itemmetadata><bbmd_asi_object_id>_797984_1</bbmd_asi_object_id><bbmd_asitype>Item</bbmd_asitype><bbmd_assessmenttype>Test</bbmd_assessmenttype><bbmd_sectiontype>Subsection</bbmd_sectiontype><bbmd_questiontype>Essay</bbmd_questiontype><bbmd_is_from_cartridge>false</bbmd_is_from_cartridge><bbmd_is_disabled>false</bbmd_is_disabled><bbmd_negative_points_ind>N</bbmd_negative_points_ind><bbmd_canvas_fullcrdt_ind>false</bbmd_canvas_fullcrdt_ind><bbmd_all_fullcredit_ind>false</bbmd_all_fullcredit_ind><bbmd_numbertype>none</bbmd_numbertype><bbmd_partialcredit/><bbmd_orientationtype>vertical</bbmd_orientationtype><bbmd_is_extracredit>false</bbmd_is_extracredit><bbmd_ai_state>No</bbmd_ai_state><qmd_absolutescore_max>1.000000000000000</qmd_absolutescore_max><qmd_weighting>0</qmd_weighting><qmd_instructornotes/></itemmetadata><presentation><flow class="Block"><flow class="QUESTION_BLOCK"><flow class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="HTML">To make sure that you use email effectively, efficiently, and safely, what guidelines should you follow? List at least FIVE.</mat_formattedtext></mat_extension></material></flow></flow><flow class="RESPONSE_BLOCK"><response_str ident="response" rcardinality="Single" rtiming="No"><render_fib charset="us-ascii" encoding="UTF_8" rows="8" columns="127" maxchars="0" prompt="Box" fibtype="String" minnumber="0" maxnumber="0"/></response_str></flow></flow></presentation><resprocessing scoremodel="SumOfScores"><outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0.0" minvalue="0.0" maxvalue="1.00"/></outcomes><respcondition title="correct"><conditionvar/><setvar variablename="SCORE" action="Set">SCORE.max</setvar><displayfeedback linkrefid="correct" feedbacktype="Response"/></respcondition><respcondition title="incorrect"><conditionvar><other/></conditionvar><setvar variablename="SCORE" action="Set">0.0</setvar><displayfeedback linkrefid="incorrect" feedbacktype="Response"/></respcondition></resprocessing><itemfeedback ident="correct" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="incorrect" view="All"><flow_mat class="Block"><flow_mat class="FORMATTED_TEXT_BLOCK"><material><mat_extension><mat_formattedtext type="SMART_TEXT"/></mat_extension></material></flow_mat></flow_mat></itemfeedback><itemfeedback ident="solution" view="All"><solution view="All" feedbackstyle="Complete"><solutionmaterial><flow_mat class="Block"><material><mat_extension><mat_formattedtext type="HTML">Any five of the following are acceptable:&lt;br&gt;•	Do not send large files (including large attachments) without prior notice.&lt;br&gt;•	Proofread every message.&lt;br&gt;•	Respect other people&amp;#x27;s electronic space by sending messages only when necessary.&lt;br&gt;•	Respond to messages promptly.&lt;br&gt;•	Avoid overusing the label &amp;quot;urgent.&amp;quot;&lt;br&gt;•	Be careful about using the &amp;quot;reply all&amp;quot; button.&lt;br&gt;•	Remember that email is not always private.&lt;br&gt;•	Use the &amp;quot;Save as Draft&amp;quot; feature to give yourself time to consider the style and tone of important messages.&lt;br&gt;•	Many people read their emails on smartphones, so keep messages brief and to the point.&lt;br&gt;•	Use complete sentences with proper punctuation and spelling.</mat_formattedtext></mat_extension></material></flow_mat></solutionmaterial></solution></itemfeedback></item></section></assessment></questestinterop>